# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── Multiple instances ──
# kernel:
#   type: "singbox"
# log:
#   level: "info"
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only

# ── User sync interval ──
# node:
#   user_sync_interval: 300    # 定期从面板同步用户列表的间隔（秒），默认 300（5分钟）
#                               # 即使 WebSocket 连接正常，也会定期兜底拉取用户列表，
#                               # 避免因 WS 推送遗漏导致新用户无法连接
